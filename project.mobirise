              ".mbr-text": {
                "margin-bottom": "10px"
              }
            },
            ".list-wrapper": {
              "margin-bottom": "110px",
              "@media (max-width: 1200px)": {
                "margin-bottom": "70px"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "35px"
              },
              ".list": {
                "padding": "0",
                "margin": "0",
                "list-style-type": "none",
                ".item-wrap": {
                  "cursor": "pointer",
                  "margin-bottom": "12px",
                  "transition": "all 0.3s ease-in-out",
                  "&:hover, &:focus": {
                    "color": "@activeList"
                  },
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".content-wrap": {
              "margin-bottom": "110px",
              "@media (max-width: 1200px)": {
                "margin-bottom": "70px"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "35px"
              },
              ".mbr-desc": {
                "margin-bottom": "20px"
              },
              ".social-wrapper": {
                ".social-wrap": {
                  "display": "inline-flex",
                  ".soc-item": {
                    "a": {
                      "display": "block",
                      "&:hover, &:hover": {
                        ".mbr-iconfont": {
                          "color": "@active"
                        }
                      },
                      ".mbr-iconfont": {
                        "display": "flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "26px",
                        "height": "26px",
                        "color": "@socColor",
                        "font-size": "26px",
                        "transition": "all 0.3s ease-in-out",
                        "margin": "0 10px 10px"
                      }
                    }
                  }
                }
              }
            },
            ".copy-wrapper": {
              ".mbr-section-btn-main": {
                "margin-bottom": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "15px"
                }
              },
              ".mbr-copy": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".list": {
              "color": "#000000"
            },
            ".mbr-desc": {
              "color": "#000000"
            },
            ".mbr-copy": {
              "color": "#000000"
            },
            ".mbr-desc, .social-wrapper": {
              "text-align": "center"
            },
            ".mbr-copy, .mbr-section-btn-main": {
              "text-align": "center"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 ridem5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"List 1\" name=\"showList_1\" checked>\n        <input type=\"checkbox\" title=\"List 2\" name=\"showList_2\" checked>\n        <input type=\"color\" title=\"List Active Color\" value=\"#ffffff\" name=\"activeList\" condition=\"showList_1 || showList_2\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" condition=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#000000\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#ffffff\" name=\"active\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Main Buttons\" name=\"showMainButtons\" checked>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e7f4c9\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-4\" mbr-if=\"showTitle || showText || showButtons\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Go Green Steam Clean</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Ratheven, <br>Portlaoise, <br>Co. Laois, <br>R32 DY00<br><br>085-836 0077<br>\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            START NOW\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-2\" mbr-if=\"showList_1\">\n                <div class=\"list-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-primary\"><b>Home</b></a></li>\n                        <li class=\"item-wrap\"><a href=\"contact-us.html\" class=\"text-primary\"><b>Contact Us</b></a></li>\n                        <li class=\"item-wrap\"><a href=\"services.html\" class=\"text-primary\"><b>Services</b></a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3\" mbr-if=\"showList_2\">\n                <div class=\"list-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><span style=\"color: rgb(0, 0, 0); font-size: 1.125rem;\"><a href=\"privacy-policy.html\" class=\"text-primary\"><b>Privacy Policy</b></a></span><br></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-if=\"showSocial\">\n                <div class=\"content-wrap\">\n                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .social-wrapper\">\n                        <b>Connect with us on social media</b>\n                    </p>\n                    <div class=\"social-wrapper\">\n                        <div class=\"social-wrap\">\n                            <div class=\"soc-item\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-tiktok\"></span>\n                                </a>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                <a href=\"https://mobiri.se/\">\n                                    <span mbr-icon class=\"mbr-iconfont socicon socicon-linkedin\"></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-if=\"showMainButtons || showCopy\">\n                <div class=\"copy-wrapper\">\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn-main\" mbr-if=\"showMainButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"mailto:gogreensteamclean.ie@gmail.com\" data-app-placeholder=\"Type Text\"><span class=\"socicon socicon-mailru mbr-iconfont mbr-iconfont-btn\"></span>gogreensteamclean.ie@gmail.com</a></div>\n                    <p class=\"mbr-copy mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCopy\" data-app-selector=\".mbr-copy, .mbr-section-btn-main\">\n                        © Copyright 2025 Go Green Steam Clean - All Rights Reserved\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uRNOa6yxPI",
          "_anchor": "footer01-m",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n    <h1 class=\"display-1\">Custom HTML Block</h1>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"#777\" width=\"200\" height=\"200\"><path d=\"M6.1 8.7L2.8 12l3.3 3.3-1.4 1.4L0 12l4.7-4.7 1.4 1.4zm13.2-1.4l-1.4 1.4 3.3 3.3-3.3 3.3 1.4 1.4L24 12l-4.7-4.7zM8.1 18.6l1.8.8 6-14-1.8-.8-6 14z\"></path></svg>\n    <p class=\"display-3\">Click to Open Code Editor</p>\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "ridem5",
          "_anchor": "custom-html-n"
