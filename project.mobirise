        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "position": "relative",
            "overflow": "hidden",
            "display": "flex",
            "align-items": "center",
            ".decor-wrap": {
              "position": "absolute",
              "right": "0",
              "width": "60%",
              "height": "150%",
              "border-radius": "100% 0 0 100%",
              "background-color": "@decor",
              "pointer-events": "none",
              "@media (max-width: 992px)": {
                "width": "100%"
              },
              "& when (@reverseContent)": {
                "border-radius": "0 100% 100% 0",
                "right": "auto",
                "left": "0"
              }
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "position": "relative",
              "z-index": "1"
            },
            ".content-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "22px"
              },
              ".mbr-text": {
                "margin-bottom": "22px"
              }
            },
            ".mbr-section-title": {
              "color": "#212529"
            },
