          },
          "_name": "features03",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 ridem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Date\" name=\"showDate\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#a7c169\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e7f4c9\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Services</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\">\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get a quote</a></div>\n            </div>\n            <div class=\"item features-image col-12 item-mb\">\n                \n                    <div class=\"item-wrapper\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                <b>EVENT</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202025-07-2820at2013.51.35203-740x416.webp\" alt=\"Rug Steam Cleaning\">\n                        </div>\n                        <div class=\"item-content\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Rug Steam Cleaning</b><br></p>\n                            <div class=\"date-wrapper\">\n                                <div class=\"date-wrap\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-calendar mobi-mbri\"></span>\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".item-date, .date-wrapper\">Restore the beauty and hygiene of your rugs with our expert rug steam cleaning service in Laois and surrounding counties. Using state-of-the-art professional rug cleaning equipment, we safely remove deep-seated dirt, allergens, and stubborn stains for a healthier home environment. Book affordable rug deep cleaning near you and enjoy fresher, brighter rugs that last longer.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                \n            </div>\n            <div class=\"item features-image col-12 item-mb\">\n                \n                    <div class=\"item-wrapper\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                <b>EVENT</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202025-07-2820at2013.51.36-556x370.webp\" alt=\"Fabric Protection (Scotchgard)\">\n                        </div>\n                        <div class=\"item-content\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Fabric Protection (Scotchgard)</b><br></p>\n                            <div class=\"date-wrapper\">\n                                <div class=\"date-wrap\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-calendar mobi-mbri\"></span>\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".item-date, .date-wrapper\">Protect your home’s furnishings and investment with our professional fabric protection service, expertly applied using advanced spray technology. Our treatment forms an invisible barrier on your upholstery, making spills, stains, and dirt easy to wipe away, so your furniture stays cleaner and fresher for longer. Choose peace of mind and convenience—enjoy beautiful, well-maintained upholstery with minimal effort.<br></p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                \n            </div>\n            <div class=\"item features-image col-12 item-mb\">\n                \n                    <div class=\"item-wrapper\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                <b>EVENT</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202025-07-2320at2019.53.20-740x416.webp\" alt=\"Mobirise\">\n                        </div>\n                        <div class=\"item-content\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Water Tank Cleaning<br></b></p>\n                            <div class=\"date-wrapper\">\n                                <div class=\"date-wrap\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-calendar mobi-mbri\"></span>\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".item-date, .date-wrapper\">Experience crystal-clear water with our professional Water Tank Cleaning Service, ensuring safe, hygienic, and bacteria-free storage for your home or business. Our expert team uses advanced cleaning techniques to eliminate sediment, algae, and contaminants, enhancing water quality and system efficiency. Book your trusted water tank cleaning today and enjoy pure, fresh water.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                \n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "features03-f",
          "_cid": "uRHRds7mfr",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
