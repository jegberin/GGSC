                "margin-bottom": "50px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                }
              },
              ".mbr-text": {
                "margin-bottom": "50px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                }
              },
              ".logo-wrapper": {
                ".logo-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  ".image-wrap": {
                    "margin-right": "12px",
                    "img": {
                      "width": "56px",
                      "height": "56px",
                      "object-fit": "contain"
                    }
                  },
                  ".desc-wrapper": {
                    ".mbr-section-subtitle": {
                      "margin-bottom": "0"
                    },
                    ".mbr-desc": {
