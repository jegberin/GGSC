  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Home",
        "meta_descr": "Go Green Steam Clean is your trusted, locally owned steam cleaning specialist serving Laois, Kildare, Carlow, Kilkenny, Tipperary, Offaly, and Westmeath. With over 10 years’ experience, our family-run business delivers high-quality steam cleaning for carpets, upholstery, mattresses, rugs, and water tanks—keeping your home fresh, healthy, and allergen-free. We use advanced technology to ensure a deep, hygienic clean that’s safe for your family and gentle on your furnishings. Choose professional, eco-friendly cleaning and enjoy better health, long-lasting results, and exceptional service every time. Contact Go Green Steam Clean today for reliable, affordable cleaning you can feel good about.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/whatsapp%2520image%25202025-07-22%2520at%252019.32.44-500x500.jpg"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
