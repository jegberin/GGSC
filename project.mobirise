              }
            },
            ".dragArea.row": {
              "position": "relative",
              "z-index": "1",
              ".form-group": {
                "margin-bottom": "30px !important",
                "@media (max-width: 992px)": {
                  "margin-bottom": "15px !important"
                },
                ".form-control-label": {
                  "width": "100%",
                  "margin-bottom": "0",
