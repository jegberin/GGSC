                  "background-color": "@inputBg",
                  "&:hover, &:focus": {
                    "border": "none !important"
                  },
                  "&::placeholder": {
                    "color": "@primaryColor"
                  }
                },
                "textarea": {
                  "min-height": "140px"
                },
                ".form-check": {
                  "padding-left": "1.9em",
                  "margin-bottom": "16px",
                  ".form-check-input": {
                    "background-color": "@primaryColor",
                    "border-color": "@primaryColor",
                    "border-radius": "0"
                  }
                }
              },
              ".mbr-section-btn": {
                "width": "100%"
              }
            },
            ".content-wrapper": {
              ".mbr-section-subtitle": {
                "margin-bottom": "30px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "15px"
                }
              },
              ".list-wrapper": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style-type": "none",
                  ".item-wrap": {
                    "margin-bottom": "15px",
                    "transition": "all 0.3s ease-in-out",
                    "cursor": "pointer",
                    "&:hover, &:focus": {
                      "color": "@activeCont"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    }
                  }
                }
              },
              ".content-wrap": {
                "margin-top": "70px",
                "@media (max-width: 992px)": {
                  "margin-top": "35px"
                },
                ".mbr-desc": {
                  "margin-bottom": "30px"
                },
                ".social-wrapper": {
                  ".social-wrap": {
                    "display": "inline-flex",
                    ".soc-item": {
                      "a": {
                        "display": "block",
                        "&:hover, &:hover": {
                          ".mbr-iconfont": {
                            "color": "@active"
                          }
                        },
                        ".mbr-iconfont": {
                          "display": "flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "width": "26px",
                          "height": "26px",
                          "color": "@socColor",
                          "font-size": "26px",
                          "transition": "all 0.3s ease-in-out",
                          "margin": "0 10px 10px"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".list": {
              "color": "#000000"
            },
            ".mbr-desc": {
              "color": "#000000"
            },
            "label": {
              "color": "#000000"
            }
          },
          "_name": "form01",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 ridem5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"color\" title=\"Contacts Active Color\" value=\"#353535\" name=\"activeCont\" condition=\"showContacts\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" condition=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"4\" step=\"1\" value=\"1\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#3a7d04\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#3a7d04\" name=\"active\" condition=\"showSocial\" selected>\n        <header>Form</header>\n        <input type=\"color\" title=\"Input BG\" value=\"#ffffff\" name=\"inputBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e7f4c9\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showText\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                        <b>Enjoy the Ride</b>\n                    </h2>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            Are you ready to zip through the city streets with ease and style? Say hello to the future\n                            of\n                            urban transportation with our electric scooter rental service! Whether you're a local\n                            looking to\n                            breeze through your daily commute.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div mbr-form class=\"mbr-form form-wrapper\">\n<!--Formbuilder Form-->\n<form action=\"gogreensteamclean.ie@gmail.com\" name=\"GoGreenSteamClean website\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3 mb-3 mb-3\" data-for=\"name\">\n<label mbr-text mbr-theme-style=\"display-4\" for=\"name\" class=\"form-control-label mbr-fonts-style\">NAME*</label>\n<input type=\"text\" name=\"name\" data-form-field=\"name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3 mb-3\" data-for=\"email\">\n<label mbr-text mbr-theme-style=\"display-4\" for=\"email\" class=\"form-control-label mbr-fonts-style\">E-MAIL*</label>\n<input type=\"email\" name=\"email\" data-form-field=\"email\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n</div>\n<div data-for=\"number\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<label mbr-text mbr-theme-style=\"display-4\" for=\"number\" class=\"form-control-label mbr-fonts-style\">PHONE*</label>\n<input type=\"number\" name=\"number\" data-form-field=\"number\" mbr-theme-style=\"display-4\" class=\"form-control\" max min=\"0\" step=\"1\" value>\n</div>\n<div data-for=\"Request\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<label mbr-text mbr-theme-style=\"display-4\" for=\"Request\" class=\"form-control-label mbr-fonts-style\">MESSAGE</label>\n<textarea name=\"Request\" data-form-field=\"Request\" mbr-theme-style=\"display-4\" class=\"form-control\"></textarea>\n</div>\n<div class=\"col mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 btn btn-primary\">SEND NOW</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n            </div>\n            <div class=\"col-12 col-lg-5\">\n                <div class=\"content-wrapper\">\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">\n                        <b>Contact for a Quote</b></h3>\n                    <div class=\"list-wrapper\" mbr-if=\"showContacts\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><b>Go Green Steam Clean<br>Ratheven<br></b><b style=\"font-size: 1.125rem;\">Portlaoise<br><b style=\"color: rgb(0, 0, 0); font-size: 1.125rem;\">Co. Laois<br><b style=\"font-size: 1.125rem;\">R32 DY00</b><br></b></b></li>\n                            <li class=\"item-wrap\"><b>www.gogreensteamclean.ie</b></li>\n                            <li class=\"item-wrap\"><b>085-836 0077</b></li>\n                            <li class=\"item-wrap\"><b>gogreensteamclean.ie@gmail.com</b></li>\n                            <li class=\"item-wrap\"><br></li>\n                        </ul>\n                    </div>\n                    <div class=\"content-wrap\" mbr-if=\"showSocial\">\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .social-wrapper\">\n                            <b>Connect with us on social media</b>\n                        </p>\n                        <div class=\"social-wrapper\">\n                            <div class=\"social-wrap\">\n                                <div class=\"soc-item\">\n                                    <a href=\"https://www.facebook.com/darren.delaney.397\" target=\"_blank\">\n                                        <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                                    </a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                    <a href=\"https://mobiri.se/\">\n                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                                    </a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                                    <a href=\"https://mobiri.se/\">\n                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-tiktok\"></span>\n                                    </a>\n                                </div>\n                                <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                                    <a href=\"https://mobiri.se/\">\n                                        <span mbr-icon class=\"mbr-iconfont socicon socicon-linkedin\"></span>\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uSeCwKhlgj",
          "_anchor": "form01-19",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 30px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 30px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".map-wrapper": {
              "height": "386px",
              "background-color": "@container",
              "position": "relative",
              "padding": "40px 40px 0 40px",
              "margin-bottom": "134px",
              "@media (max-width: 992px)": {
                "padding": "20px 20px 0 20px"
              },
              ".google-map": {
                "iframe": {
                  "height": "418px",
                  "border-radius": "0 !important"
                }
              }
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "20px",
              "padding-left": "100px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding-left": "0"
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                },
                ".item-wrapper": {
                  ".card-box": {
                    ".item-title": {
                      "margin-bottom": "10px"
                    },
                    ".desc-wrap": {
                      "&:hover, &:focus": {
                        ".item-desc::before": {
                          "width": "100%"
                        }
                      },
                      ".item-desc": {
                        "display": "inline-flex",
                        "width": "fit-content",
                        "margin-bottom": "0",
                        "position": "relative",
                        "&::before": {
                          "content": "''",
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "height": "2px",
                          "width": "0",
                          "background-color": "@active",
                          "transition": "all .3s ease"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".item-menu-overlay": {
              ".btn-wrapper": {
                "margin-top": "-10%"
              }
            },
            ".item-title": {
              "color": "#144031"
            },
            ".item-desc": {
              "color": "#144031"
            },
            ".item-desc, .desc-wrap": {
              "text-align": "left"
            }
          },
          "_name": "map01",
          "_sourceTheme": "carem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"map01 carem5\" group=\"Contact\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" condition=\"showContacts\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\" condition=\"showContacts\">\n        <input type=\"color\" title=\"Active Color\" value=\"#d0e59f\" name=\"active\" condition=\"showContacts\" selected>\n        <input type=\"color\" title=\"Container BG\" value=\"#d0e59f\" name=\"container\" selected>\n        <header>Map</header>\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d1224464.5840025528!2d-7.307646!3d53.172429!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xa1dfc1260cbe99d%3A0x4387566953b2f7b9!2sGo%20Green%20Steam%20Clean!5e0!3m2!1sen!2sie!4v1753107850151!5m2!1sen!2sie&quot; width=&quot;800&quot; height=&quot;600&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\" value=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d1224464.5840025528!2d-7.307646!3d53.172429!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xa1dfc1260cbe99d%3A0x4387566953b2f7b9!2sGo%20Green%20Steam%20Clean!5e0!3m2!1sen!2sie!4v1753107850151!5m2!1sen!2sie&quot; width=&quot;800&quot; height=&quot;600&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/carem5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e7f4c9\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/carem5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"map-wrapper\">\n                    <div class=\"google-map\" mbr-map=\"googleMap\"></div>\n                </div>\n                <div class=\"items-wrapper\" mbr-if=\"showContacts\">\n                    <div class=\"item features-without-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box card\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showTitle\">\n                                    <b>PHONE</b>\n                                </h4>\n                                <div class=\"desc-wrap\">\n                                    <a href=\"#\">\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-if=\"showDesc\" mbr-theme-style=\"display-7\" data-app-selector=\".item-desc, .desc-wrap\">\n                                            We cover&nbsp;Laois, Kildare, Carlow, Kilkenny, Tipperary, Offaly and Westmeath</p>\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    \n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
