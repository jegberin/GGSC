                      "justify-content": "space-between",
                      "align-items": "center",
                      "width": "100%",
                      ".panel-title-edit": {
                        "margin-bottom": "0"
                      },
                      ".icon-wrapper": {
                        "width": "48px",
                        "height": "48px",
                        "min-width": "48px",
