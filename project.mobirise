          "_name": "features01",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features01 ridem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\">\n        <input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#353535\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e7f4c9\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-if=\"showTitle || showText\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>We genuinely love what we do!</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        So we will go over and beyond to make it a pleasant experience for you!\n                    <br><br>Locally owned and operated professional steam cleaning company that specialises in steam cleaning carpets, upholstery, mattresses, rugs and water tanks.\n<br>\n<br>Covering Laois, Kildare, Carlow, Kilkenny, Tipperary, Offaly and Westmeath.&nbsp;<br></p>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4 item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont icon54-v1-medical-symbol\"></span>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\"><b>Health</b></h4>\n                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                            Improves health and hygiene in your home by removing allergens, bacteria, and contaminants..\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4 item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont icon54-v1-update-time\"></span>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\"><b>Durability</b></h4>\n                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                            Extends the longevity and appearance of your carpets, upholstery, mattresses, and water systems.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4 item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont icon54-v1-dollar-fall\"></span>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .icon-wrapper\"><b>Cost Savings</b></h4>\n                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                            Reduces maintenance time and costs by preventing stubborn stains, buildup, and damage.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"border-wrapper\" mbr-if=\"showBorder\"></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uRBe77h10b",
          "_anchor": "features01-b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "margin-bottom": "70px",
              "@media (max-width: 992px)": {
                "margin-bottom": "35px"
              }
            },
            ".mbr-section-btn": {
              "margin-bottom": "70px",
              "@media (max-width: 992px)": {
                "margin-bottom": "35px",
                "text-align": "left"
              },
              "text-align": "right"
            },
            ".item": {
              "margin-bottom": "70px",
              "@media (max-width: 992px)": {
                "margin-bottom": "35px"
              },
              "&:hover, &:focus": {
                ".item-wrapper .item-img img": {
                  "transform": "scale(1.1)"
                }
              },
              ".item-wrapper": {
                "display": "grid",
                "grid-template-columns": "25px 370px 1fr",
                "gap": "62px",
                "padding-bottom": "40px",
                "border-radius": "0 !important",
                "@media (max-width: 1200px)": {
                  "gap": "30px"
                },
                "@media (max-width: 992px)": {
                  "display": "block",
                  "padding-bottom": "30px"
                },
                "& when (@showBorder)": {
                  "border-bottom": "1px solid @border"
                },
                ".desc-wrapper": {
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  },
                  ".item-desc": {
                    "display": "inline-flex",
                    "writing-mode": "tb-rl",
                    "white-space": "nowrap",
                    "transform": "rotate(-180deg)",
                    "@media (max-width: 992px)": {
                      "display": "block",
                      "writing-mode": "inherit",
                      "white-space": "inherit",
                      "transform": "none",
                      "margin-bottom": "0"
                    }
                  }
                },
                ".item-img": {
                  "border-radius": "2rem !important",
                  "overflow": "hidden",
                  "& when not (@isRoundedImages)": {
                    "border-radius": "0 !important"
                  },
                  "@media (max-width: 992px)": {
                    "margin-bottom": "25px"
                  },
                  "img": {
                    "height": "190px",
                    "border-radius": "2rem",
                    "object-fit": "cover",
                    "transition": "all 0.5s ease-in-out"
                  }
                },
                ".item-content": {
                  ".item-text": {
                    "margin-bottom": "15px"
                  },
                  ".date-wrapper": {
                    ".date-wrap": {
                      "display": "inline-flex",
                      "align-items": "center",
                      ".icon-wrapper": {
                        "margin-right": "10px",
                        ".mbr-iconfont": {
                          "display": "block",
                          "font-size": "20px",
                          "color": "@icon"
                        }
                      },
                      ".item-date": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".item-desc": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".item-date": {
              "color": "#000000"
            }
          },
          "_name": "features03",
          "_sourceTheme": "ridem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 ridem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Date\" name=\"showDate\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#a7c169\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e7f4c9\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Services</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\">\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"contact-us.html\" data-app-placeholder=\"Type Text\">Get a quote</a></div>\n            </div>\n            <div class=\"item features-image col-12 item-mb\">\n                \n                    <div class=\"item-wrapper\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                <b>EVENT</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202025-07-2820at2013.51.35202-740x387.webp\" alt=\"Carpet Steam Cleaning\">\n                        </div>\n                        <div class=\"item-content\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Carpet Steam Cleaning</b></p>\n                            <div class=\"date-wrapper\">\n                                <div class=\"date-wrap\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-calendar mobi-mbri\"></span>\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".item-date, .date-wrapper\">Carpet steam cleaning, also known as hot water extraction, is widely recognised as one of the most effective methods for deep cleaning carpets. This service uses high-temperature steam to penetrate deep into carpet fibres, removing dirt, bacteria, and allergens that standard vacuuming leaves behind. Here at Go Green Steam Clean we use advanced technology to ensure a thorough, hygienic clean, gentle on fibres and safe for your home.<br></p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                \n            </div>\n            <div class=\"item features-image col-12 item-mb\">\n                \n                    <div class=\"item-wrapper\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                <b>EVENT</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202025-07-2820at2015.51.12201-740x555.webp\" alt=\"Mattress Steam Cleaning\">\n                        </div>\n                        <div class=\"item-content\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Mattress Steam Cleaning</b></p>\n                            <div class=\"date-wrapper\">\n                                <div class=\"date-wrap\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-calendar mobi-mbri\"></span>\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".item-date, .date-wrapper\">Restful sleep starts with a hygienic mattress. Over time, mattresses accumulate not just dust but also bacteria, dead skin cells, and microscopic allergens that can disrupt your health and comfort. A professional mattress steam cleaning service targets these hidden contaminants, offering a cleaner environment for you and your family.<br></p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                \n            </div>\n            <div class=\"item features-image col-12 item-mb\">\n                \n                    <div class=\"item-wrapper\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                <b>EVENT</b>\n                            </p>\n                        </div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202025-07-2820at2015.51.12-740x493.webp\" alt=\"Upholstery Steam Cleaning\">\n                        </div>\n                        <div class=\"item-content\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\"><b>Upholstery Steam Cleaning</b><b><br></b></p>\n                            <div class=\"date-wrapper\">\n                                <div class=\"date-wrap\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-calendar mobi-mbri\"></span>\n                                    </div>\n                                    <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDate\" data-app-selector=\".item-date, .date-wrapper\">Give your furniture a new lease of life with our professional Upholstery Steam Cleaning service. Using powerful, specialized steam technology, we deep-clean sofas and chairs to eliminate stubborn stains, dust mites, and allergens, leaving your home fresher and healthier. Our trained technicians ensure a thorough, safe clean with rapid drying times, so you can enjoy revitalized, comfortable upholstery almost immediately.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                \n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uRHM0AzDFs",
          "_anchor": "features03-d",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "margin-bottom": "70px",
              "@media (max-width: 992px)": {
                "margin-bottom": "35px"
              }
            },
            ".mbr-section-btn": {
              "margin-bottom": "70px",
              "@media (max-width: 992px)": {
                "margin-bottom": "35px",
                "text-align": "left"
              },
              "text-align": "right"
            },
            ".item": {
              "margin-bottom": "70px",
              "@media (max-width: 992px)": {
                "margin-bottom": "35px"
              },
              "&:hover, &:focus": {
                ".item-wrapper .item-img img": {
                  "transform": "scale(1.1)"
                }
              },
              ".item-wrapper": {
                "display": "grid",
                "grid-template-columns": "25px 370px 1fr",
                "gap": "62px",
                "padding-bottom": "40px",
                "border-radius": "0 !important",
                "@media (max-width: 1200px)": {
                  "gap": "30px"
                },
                "@media (max-width: 992px)": {
                  "display": "block",
                  "padding-bottom": "30px"
                },
                "& when (@showBorder)": {
                  "border-bottom": "1px solid @border"
                },
                ".desc-wrapper": {
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  },
                  ".item-desc": {
                    "display": "inline-flex",
                    "writing-mode": "tb-rl",
                    "white-space": "nowrap",
                    "transform": "rotate(-180deg)",
                    "@media (max-width: 992px)": {
                      "display": "block",
                      "writing-mode": "inherit",
                      "white-space": "inherit",
                      "transform": "none",
                      "margin-bottom": "0"
                    }
                  }
                },
                ".item-img": {
                  "border-radius": "2rem !important",
                  "overflow": "hidden",
                  "& when not (@isRoundedImages)": {
                    "border-radius": "0 !important"
                  },
                  "@media (max-width: 992px)": {
                    "margin-bottom": "25px"
                  },
                  "img": {
                    "height": "190px",
                    "border-radius": "2rem",
                    "object-fit": "cover",
                    "transition": "all 0.5s ease-in-out"
                  }
                },
                ".item-content": {
                  ".item-text": {
                    "margin-bottom": "15px"
                  },
                  ".date-wrapper": {
                    ".date-wrap": {
                      "display": "inline-flex",
                      "align-items": "center",
                      ".icon-wrapper": {
                        "margin-right": "10px",
                        ".mbr-iconfont": {
                          "display": "block",
                          "font-size": "20px",
                          "color": "@icon"
                        }
                      },
                      ".item-date": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".item-desc": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".item-date": {
              "color": "#000000"
