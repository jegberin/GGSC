                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 30px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".map-wrapper": {
              "height": "386px",
              "background-color": "@container",
              "position": "relative",
              "padding": "40px 40px 0 40px",
              "margin-bottom": "134px",
              "@media (max-width: 992px)": {
                "padding": "20px 20px 0 20px"
              },
              ".google-map": {
                "iframe": {
                  "height": "418px",
                  "border-radius": "0 !important"
                }
              }
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "20px",
              "padding-left": "100px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding-left": "0"
              },
              ".item": {
                "@media (max-width: 992px)": {
